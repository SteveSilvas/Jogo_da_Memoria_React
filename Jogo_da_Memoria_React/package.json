{
    "name": "jogo-da-memoria",
    "homepage": "https://SteveSilvas.github.io/Jogo_da_Memoria_React",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "dev": "vite",
        "start": "vite",
        "build": "tsc --noEmit && vite build",
        "build:pages": "tsc --noEmit && cross-env VITE_BASE_PATH=/Jogo_da_Memoria_React/ vite build",
        "typecheck": "tsc --noEmit",
        "preview": "vite preview --host 0.0.0.0",
        "predeploy": "npm run build:pages",
        "deploy": "gh-pages -d dist"
    },
    "dependencies": {
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "cross-env": "^10.1.0",
        "gh-pages": "^6.3.0",
        "typescript": "~5.9.3",
        "vite": "^8.3.8"
    }
}